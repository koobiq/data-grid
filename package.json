{
    "name": "data-grid",
    "version": "0.0.0",
    "homepage": "https://github.com/koobiq/data-grid",
    "bugs": "https://github.com/koobiq/data-grid/issues",
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/koobiq/data-grid.git"
    },
    "packageManager": "yarn@4.1.1",
    "scripts": {
        "prepare": "husky",
        "clean": "yarn cache clean && nx reset && rimraf .angular dist tmp playwright-report test-results .playwright-mcp --verbose",
        "-----SERVE-----": "------------------------------------------------------------------------------------------",
        "dev:theme": "nx run ag-grid-angular:serve",
        "-----BUILD-----": "------------------------------------------------------------------------------------------",
        "build:dev:theme": "nx run ag-grid-angular:build",
        "build:theme": "nx run ag-grid-angular-theme:build",
        "build": "nx run-many --target=build",
        "-----GITHUB_RELEASE-----": "---------------------------------------------------------------------------------",
        "release:theme": "nx release --projects=ag-grid-angular-theme --skip-publish",
        "release:theme:preview": "nx release --projects=ag-grid-angular-theme --skip-publish --dry-run",
        "-----LINTERS-----": "----------------------------------------------------------------------------------------",
        "prettier": "prettier --check . --ignore-unknown",
        "prettier:fix": "yarn run prettier --write",
        "eslint": "eslint . --ext='.js,.ts,.html'",
        "eslint:fix": "yarn run eslint --fix",
        "stylelint": "stylelint '**/*.{css,scss}'",
        "stylelint:fix": "yarn run stylelint --fix",
        "lint": "concurrently \"yarn:prettier\" \"yarn:eslint\" \"yarn:stylelint\"",
        "lint:fix": "concurrently \"yarn:prettier:fix\" \"yarn:eslint:fix\" \"yarn:stylelint:fix\"",
        "-----UNIT_TESTS-----": "--------------------------------------------------------------------------------------",
        "unit:theme": "nx run ag-grid-angular-theme:test",
        "unit": "nx run-many --target=test",
        "-----E2E_TESTS-----": "--------------------------------------------------------------------------------------",
        "e2e:setup": "playwright install chromium --with-deps",
        "e2e:dev-ag-grid-angular": "playwright test ./dev/ag-grid-angular",
        "e2e:docker": "node tools/e2e/run.cjs",
        "e2e:docker:update-snapshots": "node tools/e2e/run.cjs yarn run e2e:dev-ag-grid-angular --update-snapshots"
    },
    "dependencies": {
        "@angular/animations": "^18.2.14",
        "@angular/cdk": "^18.2.13",
        "@angular/common": "^18.2.14",
        "@angular/compiler": "^18.2.14",
        "@angular/core": "^18.2.14",
        "@angular/forms": "^18.2.14",
        "@angular/platform-browser": "^18.2.14",
        "@angular/platform-browser-dynamic": "^18.2.14",
        "@angular/router": "^18.2.14",
        "@fontsource/inter": "^5.2.8",
        "@koobiq/design-tokens": "^3.18.0",
        "@koobiq/icons": "^10.10.3",
        "ag-grid-angular": "^34.3.1",
        "ag-grid-community": "^34.3.1",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "rxjs": "~7.8.0",
        "xlsx": "^0.18.5",
        "zone.js": "~0.16.2"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^18.2.21",
        "@angular-devkit/core": "^18.2.18",
        "@angular-devkit/schematics": "^18.2.21",
        "@angular-eslint/eslint-plugin": "^18.2.0",
        "@angular-eslint/eslint-plugin-template": "^18.2.0",
        "@angular-eslint/template-parser": "^18.2.0",
        "@angular/cli": "^18.2.21",
        "@angular/compiler-cli": "^18.2.14",
        "@angular/language-service": "^18.2.14",
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@nx/angular": "^20.8.4",
        "@nx/jest": "^20.8.4",
        "@nx/js": "^20.8.4",
        "@playwright/test": "^1.62.0",
        "@schematics/angular": "^18.2.18",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.15.47",
        "@testing-library/angular": "16.0.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@types/eslint": "^8.56.12",
        "@types/jest": "^29.5.12",
        "@types/node": "^24.10.4",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "concurrently": "^9.2.3",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-eslint-comments": "^3.2.0",
        "eslint-plugin-jest": "^29.16.0",
        "eslint-plugin-playwright": "^2.11.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-rxjs": "^5.0.3",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jest-fail-on-console": "^3.3.4",
        "jest-preset-angular": "14.6.2",
        "lint-staged": "^15.5.2",
        "ng-packagr": "^18.2.0",
        "nx": "^20.8.4",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-sh": "^0.19.0",
        "rimraf": "^5.0.5",
        "stylelint": "^16.26.1",
        "stylelint-config-standard-scss": "^14.0.0",
        "stylelint-prettier": "^5.0.3",
        "ts-node": "^10.9.2",
        "tslib": "^2.3.0",
        "typescript": "5.5.4"
    }
}
